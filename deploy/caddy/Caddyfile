# Project Nova — Caddyfile
# TLS, HTTP/2 and HTTP/3 are automatic. Voice media never passes through here.
nova.example.com {
	encode zstd br gzip

	# WebSocket gateway and REST API.
	reverse_proxy 127.0.0.1:8080 {
		health_uri /healthz
		health_interval 10s
	}

	# Static assets embedded in the binary are served by the app itself.
	# CSP und Permissions-Policy setzt `nova serve` selbst für die Seite
	# (Kamera, Mikrofon und Bildschirm nur für die eigene Origin). Hier nicht
	# noch einmal setzen: Caddy würde den Header der App ersetzen – bis 0.8
	# stand hier `camera=()`, das hätte die Kamera im Sprachkanal gesperrt.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
	}
}

# Local development (no TLS).
:8081 {
	reverse_proxy 127.0.0.1:8080
}
